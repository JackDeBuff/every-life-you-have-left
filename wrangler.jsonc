{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "every-life-you-have-left",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    // SPA: unknown paths serve index.html; only these wake the Worker (/s/* = shared postcards).
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/agents/*", "/media/*", "/s/*"]
  },
  "observability": { "enabled": true }, // never console.log request bodies (personal data)
  "limits": { "cpu_ms": 60000 },
  "vars": {
    "GCP_PROJECT": "triangle-ai-hack-2026",
    "GCP_LOCATION": "global",
    "MODEL_HEAVY": "gemini-3.8-flash",
    "MODEL_FAST": "gemini-3.5-flash-lite",
    "MODEL_QUALITY": "gemini-4-argon",
    "MODEL_FALLBACK": "gemini-3.6-flash",
    // Verified Sat Nov 7: portraits (illustrated) and Gemini TTS on Agent Platform.
    "MODEL_IMAGE": "gemini-3.1-flash-image",
    "MODEL_TTS": "gemini-3.8-flash-tts",
    // Session engine: "real" = worker/engine/index.ts (falls back to mock if missing), "mock" = engine-mock.ts.
    "ENGINE": "real",
    // Kill switch (D-032): "false" turns all Gemini calls off and forces the mock engine.
    "GENERATION_ENABLED": "true",
    // Spend caps (worker/spend.ts). App-wide, since the ledger started (Sat Nov 7 ~5pm EST, when
    // $58.76 of the $100 hackathon credit was left): at the cap every model call stops like the
    // kill switch. Per session: past the soft cap no more small cards; past the hard cap no more calls.
    "SPEND_CAP_USD": "30",
    "SESSION_SOFT_CAP_USD": "2.5",
    "SESSION_HARD_CAP_USD": "5"
  },
  // One SessionAgent (Agents SDK, SQLite-backed Durable Object) per session: /agents/session-agent/<id>
  "durable_objects": {
    "bindings": [{ "name": "SessionAgent", "class_name": "SessionAgent" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SessionAgent"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "elyl-db",
      "database_id": "33c86b7e-a0d5-4f5c-a15e-ab290e1faabe",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "UPLOADS", "bucket_name": "elyl-uploads" }],
  // Retention (D-101, worker/privacy.ts): saved lives erased after 30 days, uploads/selfies after 7.
  "triggers": { "crons": ["17 7 * * *"] }
  // Secrets (never in this file): GCP_API_KEY, ADMIN_PASSCODE, DATA_KEY (32 random bytes, base64:
  // encrypts uploads, their text and selfies, worker/crypto.ts)
  //   local: .dev.vars   remote: npx wrangler secret put <NAME>
}

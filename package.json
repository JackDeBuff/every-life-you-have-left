{
  "name": "every-life-you-have-left",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc -b",
    "cf-typegen": "wrangler types --strict-vars=false",
    "check:demo": "tsx scripts/check-demo.ts",
    "db:migrate:local": "wrangler d1 migrations apply elyl-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply elyl-db --remote",
    "eval": "tsx scripts/eval/index.ts",
    "demo:build": "tsx scripts/demo/build-alex.ts"
  },
  "dependencies": {
    "@fontsource-variable/mona-sans": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "eventsource-parser": "^4.1.3",
    "gsap": "^3.15.1",
    "hono": "^4.13.16",
    "motion": "^14.10.1",
    "partial-json": "^0.1.7",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.67.0",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261101.1": true,
    "workerd@1.20261104.1": true
  }
}
